---
import { getImage } from 'astro:assets';
import type { ProposalCarousel } from '../data/proposal';

interface Props {
  carousel: ProposalCarousel;
  delay?: number;
}

const { carousel, delay = 0 } = Astro.props;
const posters = await Promise.all(
  carousel.slides.map((slide) => getImage({ src: slide.poster, width: carousel.width, format: 'webp', quality: 70 })),
);
const total = carousel.slides.length;
---

<article class="carousel" data-reveal="scale" data-carousel style={`--aspect: ${carousel.width} / ${carousel.height}; --d: ${delay}s`}>
  <div class="head">
    <div class="meta">
      <span class="pill format">{carousel.format}</span>
      <h3>{carousel.title}</h3>
      <p>{carousel.description}</p>
    </div>
    <div class="arrows">
      <button class="arrow" type="button" aria-label="Ver láminas anteriores" data-prev>←</button>
      <button class="arrow" type="button" aria-label="Ver más láminas" data-next>→</button>
    </div>
  </div>
  <ul class="slides">
    {
      carousel.slides.map((slide, i) => (
        <li class="slide" style={`--i: ${i}`}>
          <video
            muted
            loop
            playsinline
            preload="none"
            poster={posters[i].src}
            width={carousel.width}
            height={carousel.height}
            aria-label={`Lámina ${i + 1} de ${total}`}
          >
            <source src={slide.src} type="video/mp4" />
          </video>
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        </li>
      ))
    }
  </ul>
</article>

<script is:inline>
  // Cada lámina se anima al pasar el mouse. En pantallas táctiles se anima la que está a la vista.
  (() => {
    const hover = matchMedia('(hover: hover)').matches;
    document.querySelectorAll('[data-carousel]').forEach((root) => {
      const track = root.querySelector('.slides');
      const prev = root.querySelector('[data-prev]');
      const next = root.querySelector('[data-next]');
      const step = () => root.querySelector('.slide').offsetWidth + 20;
      const update = () => {
        prev.disabled = track.scrollLeft <= 4;
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      };
      prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
      next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
      track.addEventListener('scroll', update, { passive: true });
      addEventListener('resize', update);
      update();
    });
    document.querySelectorAll('[data-carousel] .slide').forEach((slide) => {
      const video = slide.querySelector('video');
      const play = () => video.play().catch(() => {});
      const stop = () => {
        video.pause();
        video.currentTime = 0;
      };
      if (hover) {
        slide.addEventListener('mouseenter', play);
        slide.addEventListener('mouseleave', stop);
      } else {
        new IntersectionObserver(([e]) => (e.isIntersecting ? play() : stop()), { threshold: 0.7 }).observe(slide);
      }
    });
  })();
</script>

<style>
  .carousel {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 20px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
  }
  .arrows {
    display: flex;
    gap: 10px;
    flex: none;
  }
  .arrow {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgb(239 236 230 / 0.35);
    background: transparent;
    color: var(--paper);
    font: 400 20px/1 var(--sans);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }
  .arrow:hover:not(:disabled) {
    background: var(--paper);
    color: var(--deep);
  }
  .arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 0 4px;
  }
  .format {
    background: var(--paper);
    color: var(--deep);
    margin-bottom: 4px;
  }
  h3 {
    margin: 0;
    font-weight: 900;
    font-size: 20px;
    letter-spacing: -0.01em;
  }
  p {
    margin: 0;
    max-width: 560px;
    font-size: 15px;
    line-height: 1.45;
    font-weight: 500;
    color: var(--cream);
  }
  /* Fila que se recorre hacia la derecha y sale hasta el borde de la pantalla. */
  .slides {
    list-style: none;
    margin: 0 calc(50% - 50vw) -36px 0;
    padding: 12px 24px 56px 0;
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .slides::-webkit-scrollbar {
    display: none;
  }
  .slide {
    position: relative;
    aspect-ratio: var(--aspect);
    flex: 0 0 clamp(260px, 27vw, 360px);
    scroll-snap-align: start;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid rgb(239 236 230 / 0.2);
    box-shadow: 0 18px 36px rgb(0 0 0 / 0.25);
    background: var(--dark);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .slide:hover {
    transform: translateY(-6px);
    box-shadow: 0 28px 48px rgb(0 0 0 / 0.35);
  }
  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .num {
    position: absolute;
    left: 12px;
    bottom: 10px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 26px;
    color: var(--paper);
    text-shadow: 0 2px 10px rgb(0 0 0 / 0.4);
    pointer-events: none;
  }
  @media (max-width: 720px) {
    .arrows {
      display: none;
    }
    .slides {
      margin: 0 -24px -36px;
      padding: 8px 24px 56px;
      scroll-padding: 0 24px;
      gap: 12px;
    }
    .slide {
      flex: 0 0 80%;
    }
  }
</style>
